{
  "manifest_version": 2,
  "name": "Wikipedia to Zotero",
  "version": "0.2.0",
  "description": "Import Wikipedia Saved lists with folder tags, original saved timestamps, CSV backups, and optional verified deletion.",
  "author": "Phil Hobrla",
  "homepage_url": "https://github.com/phobrla/wikipedia-to-zotero",
  "applications": {
    "zotero": {
      "id": "wikipedia-to-zotero@phobrla.github.io",
      "update_url": "https://raw.githubusercontent.com/phobrla/wikipedia-to-zotero/main/plugin/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
